<%- include('../partials/header') %>
<%- include('../partials/menu') %>
<main class="page">
  <div class="page-head">
    <h1 class="page-title"><small><%= aluno.id ? 'Edição' : 'Cadastro' %></small><%= aluno.id ? 'Editar aluno' : 'Novo aluno' %></h1>
    <a href="/alunos" class="btn btn--ghost">Voltar</a>
  </div>

  <div class="card" style="max-width:600px">
    <% if (erro) { %>
      <div class="alert alert--error"><%= erro %></div>
    <% } %>

    <form action="<%= aluno.id ? '/alunos/' + aluno.id + '?_method=PUT' : '/alunos' %>" method="POST">
      <div class="form-grid form-grid--2">
        <div class="field full">
          <label for="nome">Nome completo</label>
          <input type="text" id="nome" name="nome" value="<%= aluno.nome || '' %>" required>
        </div>
        <div class="field">
          <label for="cpf">CPF</label>
          <input type="text" id="cpf" name="cpf" value="<%= aluno.cpf || '' %>" data-mask="cpf" placeholder="000.000.000-00" required>
        </div>
        <div class="field">
          <label for="telefone">Telefone</label>
          <input type="text" id="telefone" name="telefone" value="<%= aluno.telefone || '' %>">
        </div>
        <div class="field">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" value="<%= aluno.email || '' %>">
        </div>
        <div class="field">
          <label for="data_nascimento">Data de nascimento</label>
          <input type="date" id="data_nascimento" name="data_nascimento" value="<%= aluno.data_nascimento || '' %>">
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn--primary"><%= aluno.id ? 'Salvar alterações' : 'Cadastrar aluno' %></button>
        <a href="/alunos" class="btn btn--ghost">Cancelar</a>
      </div>
    </form>
  </div>
</main>
<%- include('../partials/footer') %>
