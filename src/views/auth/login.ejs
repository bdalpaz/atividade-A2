<%- include('../partials/header') %>
<main class="login-screen">
  <div class="login-card">
    <h1 class="login-brand"><span style="color:var(--lime)">GYM</span>CONTROL</h1>
    <p class="login-tag">Controle de Academia</p>

    <% if (erro) { %>
      <div class="alert alert--error"><%= erro %></div>
    <% } %>

    <form action="/login" method="POST">
      <div class="form-grid">
        <div class="field">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" value="<%= email %>" required autofocus placeholder="seu@email.com">
        </div>
        <div class="field">
          <label for="senha">Senha</label>
          <input type="password" id="senha" name="senha" required placeholder="••••••••">
        </div>
        <button type="submit" class="btn btn--primary btn--block">Entrar</button>
      </div>
    </form>

    <div class="login-hint">
      <strong>Contas de demonstração</strong><br>
      Admin: <code>admin@gymcontrol.com</code> / <code>admin123</code><br>
      Recepção: <code>recepcao@gymcontrol.com</code> / <code>recep123</code>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
