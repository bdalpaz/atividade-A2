<%- include('../partials/header') %>
<%- include('../partials/menu') %>
<main class="page">
  <div class="page-head">
    <h1 class="page-title"><small><%= plano.id ? 'Edição' : 'Cadastro' %></small><%= plano.id ? 'Editar plano' : 'Novo plano' %></h1>
    <a href="/planos" class="btn btn--ghost">Voltar</a>
  </div>

  <div class="card" style="max-width:600px">
    <% if (erro) { %><div class="alert alert--error"><%= erro %></div><% } %>

    <form action="<%= plano.id ? '/planos/' + plano.id + '?_method=PUT' : '/planos' %>" method="POST">
      <div class="form-grid form-grid--2">
        <div class="field full">
          <label for="nome">Nome do plano</label>
          <input type="text" id="nome" name="nome" value="<%= plano.nome || '' %>" required>
        </div>
        <div class="field">
          <label for="duracao_meses">Duração (meses)</label>
          <input type="number" id="duracao_meses" name="duracao_meses" min="1" value="<%= plano.duracao_meses || '' %>" required>
        </div>
        <div class="field">
          <label for="valor">Valor (R$)</label>
          <input type="number" step="0.01" min="0" id="valor" name="valor" value="<%= plano.valor || '' %>" required>
        </div>
        <div class="field full">
          <label for="descricao">Descrição</label>
          <textarea id="descricao" name="descricao"><%= plano.descricao || '' %></textarea>
        </div>
        <div class="field field-check full">
          <input type="checkbox" id="ativo" name="ativo" <%= (plano.ativo === undefined || plano.ativo) ? 'checked' : '' %>>
          <label for="ativo" style="margin:0">Disponível para venda</label>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn--primary"><%= plano.id ? 'Salvar alterações' : 'Cadastrar plano' %></button>
        <a href="/planos" class="btn btn--ghost">Cancelar</a>
      </div>
    </form>
  </div>
</main>
<%- include('../partials/footer') %>
